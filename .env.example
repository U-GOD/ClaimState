# Hedera testnet operator account id (0.0.x). Not a secret.
HEDERA_OPERATOR_ID=

# Hex-encoded 32-byte ECDSA private key for the operator.
# Leave this empty. Put the real key in .env.local, which is gitignored.
HEDERA_OPERATOR_ECDSA_KEY=

# EVM chain id. Hedera testnet is 296. This template refuses any other value.
HEDERA_CHAIN_ID=296

# JSON-RPC URL. Public Hashio is for development only.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Mirror Node REST base URL for Hedera testnet.
HEDERA_MIRROR_BASE_URL=https://testnet.mirrornode.hedera.com
