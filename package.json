{
  "name": "claimstate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.18.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile --workspace=@claimstate/hardhat",
    "lint": "npm run typecheck --workspace=@claimstate/sdk && npm run typecheck --workspace=@claimstate/indexer && npx tsc -p packages/hardhat/tsconfig.json --noEmit",
    "test": "npm run test --workspace=@claimstate/sdk && npm run test --workspace=@claimstate/indexer && npm run test --workspace=@claimstate/hardhat",
    "scaffold:check": "node scripts/check-scaffold.mjs",
    "harness:doctor": "hedera-harness doctor .harness/spec.yaml --recipe-only",
    "harness:validate": "hedera-harness validate .harness/spec.yaml",
    "dev": "npm run dev --workspace=@claimstate/nextjs",
    "deploy:testnet": "npm run deploy:testnet --workspace=@claimstate/hardhat",
    "smoke:acknowledge": "npm run smoke:acknowledge --workspace=@claimstate/hardhat",
    "demo:obligation": "npm run demo:obligation --workspace=@claimstate/hardhat",
    "verify:mirror": "npm run verify:mirror --workspace=@claimstate/hardhat",
    "verify:activation": "npm run verify:activation --workspace=@claimstate/hardhat",
    "fixture:delinquency": "npm run fixture:delinquency --workspace=@claimstate/hardhat",
    "fixture:dispute": "npm run fixture:dispute --workspace=@claimstate/hardhat"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.88.0"
  },
  "devDependencies": {
    "hedera-harness": "1.2.2",
    "playwright": "1.61.1"
  }
}
